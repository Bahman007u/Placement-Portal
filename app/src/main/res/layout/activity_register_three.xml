<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/harvard_campus_bg">

    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="#99000000"
        app:layout_constraintWidth_percent="0.85"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/uni_logo"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="GradGate UNIVERSITY"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Placement Portal"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="20dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#CCBCBCBC"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Professional Details"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:layout_marginBottom="16dp"/>

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/edit_text_rounded_bg"
                        android:drawableStart="@drawable/emaillogin"
                        android:drawablePadding="10dp"
                        android:hint="University ID/ Email"
                        android:paddingStart="12dp"
                        android:inputType="textEmailAddress"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etSkills"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/edit_text_rounded_bg"
                        android:drawableStart="@drawable/resume"
                        android:drawablePadding="10dp"
                        android:hint="Skills (eg, Python, Kotlin)"
                        android:inputType="text"
                        android:paddingStart="12dp" />

                    <EditText
                        android:id="@+id/et_upload_resume"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/edit_text_rounded_bg"
                        android:drawableStart="@drawable/upload"
                        android:drawablePadding="10dp"
                        android:hint="Upload Resume"
                        android:paddingStart="12dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etLinkedin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/edit_text_rounded_bg"
                        android:drawableStart="@drawable/linkedin"
                        android:drawablePadding="10dp"
                        android:hint="LinkedIn URL"
                        android:inputType="textUri"
                        android:paddingStart="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_complete_registration"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:backgroundTint="#8A0000"
                        android:text="Complete Registration"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:cornerRadius="25dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Already Registered? Login"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>